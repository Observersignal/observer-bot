# ============================================================================
#  The Observer — Auto-Execution Bot · client configuration
# ----------------------------------------------------------------------------
#  Copy this file to ".env" and fill in YOUR own values.
#      cp .env.example .env
#
#  This bot is NON-CUSTODIAL. Every value below is YOURS:
#  your account, your keys, your sizing, your risk. We never see any of it.
#  Nothing in here is ever sent to us except your signal-feed token (to
#  authenticate your subscription). Keep this file private — it is gitignored.
# ============================================================================

# --- Signal feed -----------------------------------------------------------
# Where the authenticated signal feed lives. Leave as the default.
OBSERVER_API_URL=https://api.theobserversignalbot.com

# Your personal feed token (you receive this with the add-on).
# Leave EMPTY to run in DEV MOCK MODE: the bot replays a short scripted
# sequence of fake signals locally so you can watch the mechanics end-to-end
# without a live subscription. Great for a first dry run.
#
# NOTE: this token EXPIRES (about every 35 days) and while your subscription is
# active. When it lapses the bot stops receiving signals and logs a clear
# "token expired" error. To renew: send /bot to The Observer Telegram bot, copy
# the new token here, and restart the bot.
OBSERVER_FEED_TOKEN=

# --- Your Hyperliquid account ----------------------------------------------
# Your MAIN Hyperliquid wallet address (the account that holds your funds).
HL_ACCOUNT_ADDRESS=

# Your API / AGENT WALLET private key (0x...). This is a TRADE-ONLY key:
# it can place and cancel orders on your behalf but CANNOT withdraw or
# transfer your funds. Create it from the Hyperliquid UI (API wallet) and
# paste it here. NEVER paste your main wallet's seed phrase or private key.
HL_API_SECRET=

# --- Sizing & leverage -----------------------------------------------------
# SIZING_MODE decides how each trade is sized:
#   fixed  — the same margin (below) and leverage on every signal.
#   model  — mirror the model's market-cap-tier policy, scaled to your base:
#              large-cap (>=$1B)   -> margin x1.5, 10x
#              small-cap ($100M-1B)-> margin x0.5, 5x
#              micro-cap (<$100M)  -> not traded
#            e.g. a $100 base becomes large=$150@10x, small=$50@5x.
# In BOTH modes, micro-caps (<$100M) are never traded (the model refuses them).
SIZING_MODE=fixed

# PROPORTIONAL SIZING — just enter YOUR total base capital and the bot mirrors
# the model's exact proportion per trade. The model risks 1% of its book per
# trade ($100 on a $10,000 book). So:
#     BASE_CAPITAL=5000   -> $50 margin per trade
#     BASE_CAPITAL=20000  -> $200 margin per trade
# No "cut": the bot scales every trade to your capital, nothing held back.
# In MODEL mode this per-trade figure is the x1.0 reference the tier mults scale.
BASE_CAPITAL=10000

# % of your base capital committed as margin per trade. 1.0 = the model's exact
# proportion. Lower it (e.g. 0.5) to trade smaller than the model; raise with care.
RISK_PER_TRADE_PCT=1.0

# --- Dynamic sizing --------------------------------------------------------
# OFF by default. When ON, RISK_PER_TRADE_PCT applies to your account's LIVE
# equity (margin + unrealized PnL, read from Hyperliquid before every open)
# instead of the BASE_CAPITAL you typed above — which is then ignored.
#
# Why you probably want it: a typed BASE_CAPITAL stops describing your account
# the moment it moves, and in a drawdown it errs towards MORE risk — it keeps
# sizing for money you no longer have. On a real account set to 1500 that had
# drifted down to 780, every open was still sized for 1500 until the exchange
# started rejecting orders for insufficient margin.
#
# The trade-off, so you choose with open eyes: your size now moves with the
# market — bigger when positions are working, smaller in a drawdown. That
# protects you from the spiral AND makes recoveries slower. Two signals a minute
# apart can size differently. That is the design, not a glitch.
DYNAMIC_SIZING=false

# With DYNAMIC_SIZING on: below this equity the bot stops OPENING and only
# closes. Past a point the positions are dust the exchange rejects anyway, and
# there is no sense feeding the last of the account to orders that can't work.
# 0 = no floor.
EQUITY_FLOOR_USD=0

# Leverage applied to that margin (notional = margin * LEVERAGE).
LEVERAGE=10

# Margin mode: true = ISOLATED (what the model uses), false = cross.
ISOLATED=true

# ADVANCED (optional): force a FIXED margin in USD per trade, ignoring
# BASE_CAPITAL/RISK_PER_TRADE_PCT. Leave at 0 to use the proportional sizing above.
SIZE_USD=0

# ADVANCED (optional, MODEL mode only): the x1.0 reference margin the tier
# multipliers scale (large x1.5 / small x0.5). Leave at 0 to reuse the per-trade
# figure derived from BASE_CAPITAL/RISK_PER_TRADE_PCT (or SIZE_USD).
BASE_MARGIN_USD=0

# --- Risk limits -----------------------------------------------------------
# Maximum number of positions open at the same time.
MAX_OPEN=10

# Once today's realized loss exceeds this (in USD), the bot stops OPENING
# new trades for the rest of the UTC day. Existing closes still run.
DAILY_LOSS_LIMIT_USD=300

# --- Safety ----------------------------------------------------------------
# true  = simulate only: log exactly what it WOULD do, place NO real orders.
# false = LIVE: place real orders on your account. Only flip this once you
#         have watched a dry run and you understand the behaviour.
DRY_RUN=true

# How often (seconds) to poll the feed for new signals.
POLL_SECONDS=4

# --- Event handling --------------------------------------------------------
# Whether to act on "flip" events (close current, open the opposite side).
ALLOW_FLIP=true

# Whether to act on "increase" events (add to an existing position).
# Off by default to keep behaviour conservative.
ALLOW_INCREASE=false

# ADVANCED: staleness guard for reconnects. If the bot was offline and comes
# back, OPEN signals older than this many minutes are SKIPPED (the entry has
# already moved, so chasing it is risky). CLOSE signals ALWAYS execute,
# regardless of age (closing late is safer than leaving a position open).
MAX_SIGNAL_AGE_MIN=15

# ADVANCED: maximum slippage for market orders, as a fraction (0.01 = 1%). An
# order that can't fill within this band is rejected instead of filling at a bad
# price. The SDK default is a loose 5%; 1% is a safer cap. Raise for very
# illiquid coins if you see orders not filling.
MAX_SLIPPAGE_PCT=0.01

# ADVANCED: how often (in poll cycles) to reconcile local state against your
# real Hyperliquid account — corrects any drift (e.g. a rejected order, or a
# position you opened/closed manually) and recomputes today's realized PnL so
# the daily-loss stop stays accurate. 0 disables it. Only runs in LIVE mode.
RECONCILE_EVERY=20
